let
    Source = LoadCsv("SQLMetrics.csv", {
        {"SKU", type text},
        {"Product", type text},
        {"Category", type text},
        {"Barcode", type text},
        {"Language", type text},
        {"Supplier", type text},
        {"BaseCost", type number},
        {"BulkThreshold", Int64.Type},
        {"BulkCost", type number},
        {"MOQ", Int64.Type},
        {"OrderMultiple", Int64.Type},
        {"SupplierStock", Int64.Type},
        {"CostDate", type date},
        {"LandedExtras", type number},
        {"DemandRating", Int64.Type},
        {"MonthlySales", type number},
        {"OnHand", Int64.Type},
        {"PlannedQty", Int64.Type},
        {"ShelfOverride", type number},
        {"Active", type text},
        {"CostReview", type text},
        {"Notes", type text},
        {"ProductType", type text},
        {"Benchmark", type number},
        {"SourceID", type text},
        {"Availability", type text},
        {"CheckedDate", type date},
        {"Shelf", type number},
        {"BulkUnits", Int64.Type},
        {"VAT", type number},
        {"TargetGM", type number},
        {"MinimumGM", type number},
        {"StrongGM", type number},
        {"FeeRate", type number},
        {"MinContribution", type number},
        {"BaseGM", type number},
        {"BulkGM", type number},
        {"BaseContribution", type number},
        {"BulkContribution", type number},
        {"Rating", Int64.Type},
        {"BulkVerdictSQL", type text}
    })
in
    Source
